{
	"name": "leuchtdiode/mezzio-mail",
	"description": "Mezzio module for handling mails",
	"type": "library",
	"license": "MIT",
	"homepage": "https://try2catch.com",
	"authors": [
		{
			"name": "Alex Schloegl",
