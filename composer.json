	"suggest": {
		"leuchtdiode/mezzio-monitoring": "Mandatory for health checks (^1.0.0)"
	},
	"require-dev": {
		"leuchtdiode/mezzio-testing": "^1.0.0",
		"mezzio/mezzio-laminasrouter": "^3.12.0"
	},
	"autoload": {
		"psr-4": {
